<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Gestione Olio v2</title>

<style>
:root{
 --g:#1f5133;
 --o:#708238;
 --bg:#f6f4eb;
 --tx:#18221b;
 --mu:#657068;
 --ln:#dbe2da;
 --red:#a93636
}

*{box-sizing:border-box}

body{
 margin:0;
 font:15px system-ui;
 color:var(--tx);
 background:var(--bg)
}

header{
 background:var(--g);
 color:#fff;
 padding:18px 24px;
 display:flex;
 justify-content:space-between;
 align-items:center
}

h1{margin:0;font-size:22px}
small{opacity:.8}

.app{
 display:grid;
 grid-template-columns:210px 1fr;
 min-height:calc(100vh - 66px)
}

nav{
 background:#fff;
 padding:16px 10px;
 border-right:1px solid var(--ln)
}

nav button{
 display:block;
 width:100%;
 border:0;
 background:none;
 text-align:left;
 padding:11px;
 border-radius:8px;
 font-weight:650;
 cursor:pointer
}

nav button.active,
nav button:hover{
 background:#e8f0e9;
 color:var(--g)
}

main{
 padding:24px;
 min-width:0
}

.view{display:none}
.view.active{display:block}

.title{
 display:flex;
 justify-content:space-between;
 align-items:end;
 gap:12px;
 margin-bottom:17px
}

.title h2{margin:0}
.title p{margin:4px 0;color:var(--mu)}

.actions{
 display:flex;
 gap:8px;
 flex-wrap:wrap
}

.btn{
 border:1px solid var(--ln);
 background:#fff;
 padding:9px 12px;
 border-radius:8px;
 font-weight:650;
 cursor:pointer
}

.primary{
 background:var(--g);
 color:#fff;
 border-color:var(--g)
}

.danger{color:var(--red)}

.cards{
 display:grid;
 grid-template-columns:repeat(5,1fr);
 gap:12px;
 margin-bottom:18px
}

.card,.panel{
 background:#fff;
 border:1px solid var(--ln);
 border-radius:11px
}

.card{padding:15px}

.card span{
 display:block;
 color:var(--mu);
 font-size:11px;
 text-transform:uppercase;
 font-weight:750
}

.card b{
 display:block;
 color:var(--g);
 font-size:23px;
 margin-top:5px
}

.story{
 background:#eef2e4;
 border-left:4px solid var(--o);
 padding:12px 15px;
 border-radius:0 8px 8px 0;
 margin-bottom:17px
}

.panel{
 overflow:hidden;
 margin-bottom:17px
}

.panel h3{
 margin:0;
 padding:13px 15px;
 border-bottom:1px solid var(--ln)
}

.pad{padding:16px}
.table{overflow:auto}

table{
 width:100%;
 border-collapse:collapse;
 min-width:760px
}

th,td{
 padding:9px 11px;
 border-bottom:1px solid var(--ln);
 text-align:left;
 white-space:nowrap
}

th{
 font-size:11px;
 text-transform:uppercase;
 color:var(--mu);
 background:#fafbf9
}

.num{text-align:right}

.empty{
 text-align:center;
 color:var(--mu);
 padding:28px
}

.icon{
 border:0;
 background:none;
 font-size:17px;
 cursor:pointer
}

.edit{color:var(--g)}
.delete{color:var(--red)}

.pill{
 border:0;
 border-radius:999px;
 padding:4px 9px;
 font-weight:700;
 cursor:pointer
}

.yes{
 background:#dceee1;
 color:#24633a
}

.no{
 background:#f7e2df;
 color:#8e332c
}

dialog{
 border:0;
 border-radius:13px;
 padding:0;
 width:min(680px,calc(100% - 24px));
 box-shadow:0 18px 55px #0005
}

dialog::backdrop{background:#14201999}

.mh{
 background:var(--g);
 color:#fff;
 padding:15px 18px;
 display:flex;
 justify-content:space-between
}

.mh h3{margin:0}
.mb{padding:18px}

.grid{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:13px
}

.field.full{grid-column:1/-1}

.field label{
 display:block;
 font-size:12px;
 color:var(--mu);
 font-weight:700;
 margin-bottom:4px
}

.field input,
.field textarea,
.field select{
 width:100%;
 padding:9px;
 border:1px solid #cad3ca;
 border-radius:7px;
 font:inherit
}

.ma{
 display:flex;
 justify-content:flex-end;
 gap:8px;
 margin-top:17px
}

.setup{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:15px
}

.note{
 color:var(--mu);
 font-size:13px
}

@media(max-width:900px){
 .app{grid-template-columns:1fr}

 nav{
  display:flex;
  overflow:auto;
  border:0;
  border-bottom:1px solid var(--ln)
 }

 nav button{
  width:auto;
  white-space:nowrap
 }

 .cards{grid-template-columns:1fr 1fr}
 .setup{grid-template-columns:1fr}
}

@media(max-width:560px){
 .cards,.grid{grid-template-columns:1fr}

 .title{
  align-items:start;
  flex-direction:column
 }
}

@media print{
 header,nav,.actions,.icon,dialog,#settings{
  display:none!important
 }

 body,.app,main{
  display:block;
  background:#fff;
  padding:0
 }

 .view{display:none!important}
 .view.active{display:block!important}

 .panel,.card{
  box-shadow:none;
  break-inside:avoid
 }

 .table{overflow:visible}

 table{
  min-width:0;
  font-size:10px
 }

 th,td{
  padding:5px;
  white-space:normal
 }

 .cards{grid-template-columns:repeat(5,1fr)}
 .card b{font-size:16px}

 @page{
  size:landscape;
  margin:12mm
 }
}
</style>
</head>

<body>

<header>
 <div>
  <h1>🫒 Gestione Olio</h1>
  <small>Produzione, prenotazioni, vendite e disponibilità</small>
 </div>
 <button class="btn" onclick="backup()">Esporta backup</button>
</header>

<div class="app">

<nav>
 <button class="active" data-v="dash">Riepilogo</button>
 <button data-v="prod">Produzione</button>
 <button data-v="res">Prenotazioni</button>
 <button data-v="sales">Vendite</button>
 <button data-v="settings">Impostazioni</button>
</nav>

<main>

<section id="dash" class="view active">
 <div class="title">
  <div>
   <h2>Riepilogo annuale</h2>
   <p>Vista consolidata dell’attività</p>
  </div>

  <div class="actions">
   <select id="yf" class="btn" onchange="render()"></select>
   <button class="btn" onclick="printReport()">Stampa report</button>
  </div>
 </div>

 <div id="story" class="story"></div>
 <div id="cards" class="cards"></div>

 <div class="panel">
  <h3>Andamento per anno</h3>

  <div class="table">
   <table>
    <thead>
     <tr>
      <th>Anno</th>
      <th class="num">Olive kg</th>
      <th class="num">Olio L</th>
      <th class="num">Resa</th>
      <th class="num">Costi</th>
      <th class="num">Venduto L</th>
      <th class="num">Ricavi</th>
      <th class="num">Netto</th>
      <th class="num">Prenotato L</th>
      <th class="num">Giacenza L</th>
     </tr>
    </thead>
    <tbody id="annual"></tbody>
   </table>
  </div>
 </div>
</section>

<section id="prod" class="view">
 <div class="title">
  <div>
   <h2>Produzione</h2>
   <p>Raccolte e lotti di molitura</p>
  </div>

  <div class="actions">
   <button class="btn" onclick="printReport()">Stampa report</button>
   <button class="btn primary" onclick="openForm('production')">
    + Nuova registrazione
   </button>
  </div>
 </div>

 <div class="panel">
  <div class="table">
   <table>
    <thead>
     <tr>
      <th>Raccolta</th>
      <th>Anno</th>
      <th>Appezzamento</th>
      <th class="num">Olive kg</th>
      <th>Lotto</th>
      <th>Molitura</th>
      <th class="num">Kg lotto</th>
      <th class="num">Olio L</th>
      <th class="num">Resa</th>
      <th class="num">Costo</th>
      <th>Azioni</th>
     </tr>
    </thead>
    <tbody id="pr"></tbody>
   </table>
  </div>
 </div>
</section>

<section id="res" class="view">
 <div class="title">
  <div>
   <h2>Prenotazioni</h2>
   <p>Ordini e consegne clienti</p>
  </div>

  <div class="actions">
   <button class="btn" onclick="printReport()">Stampa report</button>
   <button class="btn primary" onclick="openForm('reservations')">
    + Nuova prenotazione
   </button>
  </div>
 </div>

 <div class="panel">
  <div class="table">
   <table>
    <thead>
     <tr>
      <th>Data</th>
      <th>Anno</th>
      <th>Cliente</th>
      <th class="num">Quantità L</th>
      <th class="num">Prezzo/L</th>
      <th class="num">Totale</th>
      <th>Consegnata</th>
      <th>Note</th>
      <th>Azioni</th>
     </tr>
    </thead>
    <tbody id="rr"></tbody>
   </table>
  </div>
 </div>
</section>

<section id="sales" class="view">
 <div class="title">
  <div>
   <h2>Vendite</h2>
   <p>Consegne e stato degli incassi</p>
  </div>

  <div class="actions">
   <button class="btn" onclick="printReport()">Stampa report</button>
   <button class="btn primary" onclick="openForm('sales')">
    + Vendita diretta
   </button>
  </div>
 </div>

 <div class="panel">
  <div class="table">
   <table>
    <thead>
     <tr>
      <th>Data</th>
      <th>Anno</th>
      <th>Cliente</th>
      <th class="num">Quantità L</th>
      <th class="num">Prezzo/L</th>
      <th class="num">Totale</th>
      <th>Pagato</th>
      <th>Note</th>
      <th>Azioni</th>
     </tr>
    </thead>
    <tbody id="sr"></tbody>
   </table>
  </div>
 </div>
</section>

<section id="settings" class="view">
 <div class="title">
  <div>
   <h2>Impostazioni</h2>
   <p>Dati e accessi</p>
  </div>
 </div>

 <div class="setup">

  <div class="panel">
   <h3>Backup</h3>
   <div class="pad">
    <button class="btn primary" onclick="backup()">Esporta JSON</button>

    <label class="btn">
     Importa
     <input
      hidden
      type="file"
      accept="application/json"
      onchange="restore(this.files[0])">
    </label>
   </div>
  </div>

  <div class="panel">
   <h3>Utenti autorizzati</h3>
   <div class="pad">
    <b>Ruoli previsti</b>
    <p>
     Amministratore: utenti, modifica e cancellazione.<br>
     Operatore: inserimento e modifica.
    </p>
    <p class="note">
     Per attivare il login reale occorrono hosting HTTPS,
     registrazione Microsoft e archivio cloud condiviso.
    </p>
   </div>
  </div>

  <div class="panel">
   <h3>Archivio locale</h3>
   <div class="pad">
    <p class="note">
     Finché il cloud non è configurato, i dati restano su questo browser.
    </p>
    <button class="btn danger" onclick="resetAll()">
     Cancella tutti i dati
    </button>
   </div>
  </div>

 </div>
</section>

</main>
</div>

<dialog id="modal">
 <form id="form" onsubmit="save(event)">
  <div class="mh">
   <h3 id="mt"></h3>
   <button
    type="button"
    class="icon"
    style="color:#fff"
    onclick="modal.close()">×</button>
  </div>

  <div class="mb">
   <div id="fields" class="grid"></div>

   <div class="ma">
    <button type="button" class="btn" onclick="modal.close()">
     Annulla
    </button>
    <button class="btn primary">Salva</button>
   </div>
  </div>
 </form>
</dialog>

<script>
const K='gestioneOlio.v2';

let db=load();
let section='';
let editing='';

const euro=new Intl.NumberFormat('it-IT',{
 style:'currency',
 currency:'EUR'
});

const num=new Intl.NumberFormat('it-IT',{
 maximumFractionDigits:2
});

function load(){
 try{
  return Object.assign(
   {
    production:[],
    reservations:[],
    sales:[]
   },
   JSON.parse(localStorage.getItem(K)||'{}')
  );
 }catch{
  return {
   production:[],
   reservations:[],
   sales:[]
  };
 }
}

function persist(){
 localStorage.setItem(K,JSON.stringify(db));
 render();
}

function uid(){
 return crypto.randomUUID
  ?crypto.randomUUID()
  :Date.now()+'-'+Math.random();
}

function n(v){
 return Number(v)||0;
}

function y(d){
 return d
  ?Number(d.slice(0,4))
  :new Date().getFullYear();
}

function fd(v){
 if(!v)return '';

 const [a,b,c]=v.split('-');
 return `${c}/${b}/${a}`;
}

function esc(v=''){
 return String(v).replace(
  /[&<>"']/g,
  c=>({
   '&':'&amp;',
   '<':'&lt;',
   '>':'&gt;',
   '"':'&quot;',
   "'":'&#39;'
  }[c])
 );
}

function sold(){
 const reservations=db.reservations
  .filter(x=>x.delivered)
  .map(x=>({
   ...x,
   id:'r-'+x.id,
   linked:true,
   notes:'Da prenotazione'
  }));

 return [
  ...reservations,
  ...db.sales
 ];
}

function sum(yr){
 const p=db.production.filter(x=>y(x.harvestDate)==yr);

 const r=db.reservations.filter(
  x=>y(x.date)==yr&&!x.delivered
 );

 const s=sold().filter(x=>y(x.date)==yr);

 const olives=p.reduce(
  (total,x)=>total+n(x.olives),0
 );

 const oil=p.reduce(
  (total,x)=>total+n(x.oil),0
 );

 const cost=p.reduce(
  (total,x)=>total+n(x.cost),0
 );

 const soldLitres=s.reduce(
  (total,x)=>total+n(x.qty),0
 );

 const revenue=s.reduce(
  (total,x)=>total+n(x.qty)*n(x.price),0
 );

 const reserved=r.reduce(
  (total,x)=>total+n(x.qty),0
 );

 const due=s
  .filter(x=>!x.paid)
  .reduce(
   (total,x)=>total+n(x.qty)*n(x.price),0
  );

 return {
  yr,
  ol:olives,
  oil,
  yield:olives?oil/olives*100:0,
  cost,
  sl:soldLitres,
  rev:revenue,
  net:revenue-cost,
  rs:reserved,
  stock:oil-soldLitres-reserved,
  due
 };
}

function years(){
 const values=[
  new Date().getFullYear(),
  ...db.production.map(x=>y(x.harvestDate)),
  ...db.reservations.map(x=>y(x.date)),
  ...sold().map(x=>y(x.date))
 ];

 return [...new Set(values)].sort();
}

document.querySelectorAll('nav button').forEach(button=>{
 button.onclick=()=>{
  document
   .querySelectorAll('nav button,.view')
   .forEach(element=>element.classList.remove('active'));

  button.classList.add('active');

  document
   .getElementById(button.dataset.v)
   .classList.add('active');
 };
});

function render(){
 const availableYears=years();
 const previousYear=Number(yf.value)||new Date().getFullYear();

 yf.innerHTML=availableYears.map(value=>
  `<option ${value==previousYear?'selected':''}>
   ${value}
  </option>`
 ).join('');

 const current=sum(Number(yf.value));

 cards.innerHTML=[
  ['Olio prodotto',num.format(current.oil)+' L'],
  ['Venduto',num.format(current.sl)+' L'],
  ['Prenotato',num.format(current.rs)+' L'],
  ['Giacenza',num.format(current.stock)+' L'],
  ['Da riscuotere',euro.format(current.due)]
 ].map(item=>`
  <div class="card">
   <span>${item[0]}</span>
   <b>${item[1]}</b>
  </div>
 `).join('');

 story.innerHTML=current.oil
  ?`Nel <b>${current.yr}</b> sono stati prodotti
    <b>${num.format(current.oil)} L</b>
    con resa ${num.format(current.yield)}%.
    Giacenza disponibile:
    <b>${num.format(current.stock)} L</b>.
    Ricavo netto:
    <b>${euro.format(current.net)}</b>.`
  :`Nessuna produzione registrata nel
    <b>${current.yr}</b>.`;

 annual.innerHTML=availableYears.map(value=>{
  const item=sum(value);

  return `
   <tr>
    <td>${value}</td>
    <td class="num">${num.format(item.ol)}</td>
    <td class="num">${num.format(item.oil)}</td>
    <td class="num">${num.format(item.yield)}%</td>
    <td class="num">${euro.format(item.cost)}</td>
    <td class="num">${num.format(item.sl)}</td>
    <td class="num">${euro.format(item.rev)}</td>
    <td class="num">${euro.format(item.net)}</td>
    <td class="num">${num.format(item.rs)}</td>
    <td class="num">${num.format(item.stock)}</td>
   </tr>
  `;
 }).join('');

 renderTables();
}

function empty(columns){
 return `
  <tr>
   <td colspan="${columns}" class="empty">
    Nessun dato registrato
   </td>
  </tr>
 `;
}

function actions(sectionName,itemId,edit=true){
 const editButton=edit
  ?`<button
      class="icon edit"
      title="Modifica"
      onclick="openForm('${sectionName}','${itemId}')">✎</button>`
  :'';

 const deleteButton=`
  <button
   class="icon delete"
   title="Elimina"
   onclick="removeItem('${sectionName}','${itemId}')">×</button>
 `;

 return editButton+deleteButton;
}

function renderTables(){
 pr.innerHTML=db.production.map(item=>{
  const lotKg=db.production
   .filter(row=>row.lot&&row.lot==item.lot)
   .reduce(
    (total,row)=>total+n(row.olives),0
   );

  const yieldValue=lotKg&&item.oil
   ?n(item.oil)/lotKg*100
   :0;

  return `
   <tr>
    <td>${fd(item.harvestDate)}</td>
    <td>${y(item.harvestDate)}</td>
    <td>${esc(item.plot)}</td>
    <td class="num">${num.format(item.olives)}</td>
    <td>${esc(item.lot)}</td>
    <td>${fd(item.millDate)}</td>
    <td class="num">${item.oil?num.format(lotKg):''}</td>
    <td class="num">${item.oil?num.format(item.oil):''}</td>
    <td class="num">
     ${item.oil?num.format(yieldValue)+'%':''}
    </td>
    <td class="num">
     ${item.cost?euro.format(item.cost):''}
    </td>
    <td>${actions('production',item.id)}</td>
   </tr>
  `;
 }).join('')||empty(11);

 rr.innerHTML=db.reservations.map(item=>`
  <tr>
   <td>${fd(item.date)}</td>
   <td>${y(item.date)}</td>
   <td>${esc(item.client)}</td>
   <td class="num">${num.format(item.qty)}</td>
   <td class="num">${euro.format(item.price)}</td>
   <td class="num">
    ${euro.format(n(item.qty)*n(item.price))}
   </td>
   <td>
    <button
     class="pill ${item.delivered?'yes':'no'}"
     onclick="toggle('${item.id}','delivered')">
     ${item.delivered?'SI':'NO'}
    </button>
   </td>
   <td>${esc(item.notes)}</td>
   <td>${actions('reservations',item.id)}</td>
  </tr>
 `).join('')||empty(9);

 sr.innerHTML=sold().map(item=>`
  <tr>
   <td>${fd(item.date)}</td>
   <td>${y(item.date)}</td>
   <td>${esc(item.client)}</td>
   <td class="num">${num.format(item.qty)}</td>
   <td class="num">${euro.format(item.price)}</td>
   <td class="num">
    ${euro.format(n(item.qty)*n(item.price))}
   </td>
   <td>
    <button
     class="pill ${item.paid?'yes':'no'}"
     onclick="togglePaid('${item.id}',${Boolean(item.linked)})">
     ${item.paid?'SI':'NO'}
    </button>
   </td>
   <td>${esc(item.notes)}</td>
   <td>
    ${item.linked?'':actions('sales',item.id,true)}
   </td>
  </tr>
 `).join('')||empty(9);
}

const schema={
 production:[
  ['harvestDate','Data raccolta','date',1],
  ['plot','Appezzamento','text',1],
  ['olives','Olive raccolte (kg)','number',1],
  ['lot','Lotto molitura','text',1],
  ['millDate','Data molitura','date'],
  ['oil','Olio prodotto (L)','number'],
  ['cost','Costo molitura (€)','number'],
  ['notes','Note','textarea']
 ],

 reservations:[
  ['date','Data prenotazione','date',1],
  ['client','Cliente','text',1],
  ['qty','Quantità (L)','number',1],
  ['price','Prezzo (€/L)','number',1],
  ['delivered','Consegnata','select'],
  ['notes','Note','textarea']
 ],

 sales:[
  ['date','Data','date',1],
  ['client','Cliente','text',1],
  ['qty','Quantità (L)','number',1],
  ['price','Prezzo (€/L)','number',1],
  ['paid','Pagato','select'],
  ['notes','Note','textarea']
 ]
};

function openForm(sectionName,itemId=''){
 section=sectionName;
 editing=itemId;

 const item=itemId
  ?db[sectionName].find(row=>row.id==itemId)
  :null;

 mt.textContent=item
  ?'Modifica registrazione'
  :sectionName=='production'
  ?'Nuova produzione'
  :sectionName=='reservations'
  ?'Nuova prenotazione'
  :'Nuova vendita';

 fields.innerHTML=schema[sectionName].map(
  ([key,label,type,required])=>`
   <div class="field ${type=='textarea'?'full':''}">
    <label>${label}</label>
    ${
     type=='select'
      ?`<select name="${key}">
         <option value="false">NO</option>
         <option value="true">SI</option>
        </select>`
      :type=='textarea'
      ?`<textarea name="${key}" rows="3"></textarea>`
      :`<input
         name="${key}"
         type="${type}"
         ${type=='number'?'step="0.01" min="0"':''}
         ${required?'required':''}>`
    }
   </div>
  `
 ).join('');

 if(item){
  schema[sectionName].forEach(([key,,type])=>{
   form.elements[key].value=type=='select'
    ?String(Boolean(item[key]))
    :item[key]??'';
  });
 }

 modal.showModal();
}

function save(event){
 event.preventDefault();

 const item=Object.fromEntries(
  new FormData(event.target)
 );

 ['olives','oil','cost','qty','price'].forEach(key=>{
  if(key in item){
   item[key]=n(item[key]);
  }
 });

 ['delivered','paid'].forEach(key=>{
  if(key in item){
   item[key]=item[key]=='true';
  }
 });

 if(editing){
  const index=db[section].findIndex(
   row=>row.id==editing
  );

  item.id=editing;
  db[section][index]=item;
 }else{
  item.id=uid();
  db[section].push(item);
 }

 editing='';
 modal.close();
 event.target.reset();
 persist();
}

function removeItem(sectionName,itemId){
 if(confirm('Eliminare questa registrazione?')){
  db[sectionName]=db[sectionName].filter(
   item=>item.id!=itemId
  );

  persist();
 }
}

function toggle(itemId,key){
 const item=db.reservations.find(
  row=>row.id==itemId
 );

 item[key]=!item[key];
 persist();
}

function togglePaid(itemId,linked){
 const item=linked
  ?db.reservations.find(row=>'r-'+row.id==itemId)
  :db.sales.find(row=>row.id==itemId);

 item.paid=!item.paid;
 persist();
}

function printReport(){
 window.print();
}

function backup(){
 const file=new Blob(
  [JSON.stringify(db,null,2)],
  {type:'application/json'}
 );

 const link=document.createElement('a');

 link.href=URL.createObjectURL(file);
 link.download=
  'gestione-olio-'+
  new Date().toISOString().slice(0,10)+
  '.json';

 link.click();
 URL.revokeObjectURL(link.href);
}

function restore(file){
 if(!file)return;

 const reader=new FileReader();

 reader.onload=()=>{
  try{
   const imported=JSON.parse(reader.result);

   if(
    !imported.production||
    !imported.reservations||
    !imported.sales
   ){
    throw new Error('Backup non valido');
   }

   db=imported;
   persist();
   alert('Backup importato');
  }catch{
   alert('Backup non valido');
  }
 };

 reader.readAsText(file);
}

function resetAll(){
 if(confirm('Cancellare tutti i dati?')){
  db={
   production:[],
   reservations:[],
   sales:[]
  };

  persist();
 }
}

render();
</script>

</body>
